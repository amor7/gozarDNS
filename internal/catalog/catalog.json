   "why": {
    "fa": "این سرویس‌ها روی پورت ۴۴۳ نیستند؛ عبور دادنشان بازی را از سرور جدا می‌کند.",
    "en": "These run on ports other than 443; routing them disconnects EA games."
   },
   "domains": [
    "blaze.ea.com",
    "gameservices.ea.com",
    "gosredirector.ea.com",
    "tnt-ea.com"
   ]
  },
